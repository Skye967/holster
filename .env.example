# Copy to .env and fill in. Never commit the filled-in file.
# Every value here is a placeholder — none of these are real credentials.

# ---------------------------------------------------------------------------
# Clerk — authentication for Holster itself (https://dashboard.clerk.com)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# ---------------------------------------------------------------------------
# Supabase — PostgreSQL (https://supabase.com/dashboard)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/holster
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ---------------------------------------------------------------------------
# Token encryption
#
# Master key for the credentials service. Per-user keys are derived from this,
# so rotating it invalidates every stored token and forces users to reconnect.
# Generate with:  openssl rand -base64 32
# Read ONLY by services/credentials. No other service should receive it.
# ---------------------------------------------------------------------------
CREDENTIALS_MASTER_KEY=replace_me_with_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# Internal service URLs (docker-compose networking)
# ---------------------------------------------------------------------------
GATEWAY_URL=http://gateway:8080
AUTH_SERVICE_URL=http://auth:8081
CREDENTIALS_SERVICE_URL=http://credentials:8082
AGENT_SERVICE_URL=http://agent:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# LLM provider for the agent
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace_me

# ---------------------------------------------------------------------------
# External OAuth apps — one pair per service Holster can connect to.
# Register these with each provider. Redirect URI points at the auth service.
# ---------------------------------------------------------------------------
OAUTH_REDIRECT_BASE_URL=http://localhost:8081/oauth/callback

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
