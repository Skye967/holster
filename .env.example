# Copy to .env and fill in. Never commit the filled-in file.
# Every value here is a placeholder — none of these are real credentials.

# ---------------------------------------------------------------------------
# Clerk — authentication for Holster itself (https://dashboard.clerk.com)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk's own components/redirects send users for auth — this app's
# custom pages, not Clerk's hosted Account Portal. Static app routes, not
# deployment-specific; only change if these routes move.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# The gateway verifies session tokens offline against Clerk's public keys, so it
# needs the JWKS endpoint and issuer rather than the secret key. Both are shown on
# the API keys page in the Clerk dashboard.
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Origins allowed to mint session tokens, comma-separated. Checked against the
# token's `azp` claim — without it, any token from this Clerk instance (a JWT
# template, a machine token) would authenticate as a session. Must list every
# origin the web app is served from.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# The `aud` claim the gateway requires, set as a static value on the "gateway"
# JWT template in the Clerk dashboard. The default session token carries no
# `aud`, so the web app must request that template by name.
CLERK_AUDIENCE=holster-gateway

# Signing secret for the Clerk webhook endpoint (dashboard: Webhooks -> your
# endpoint). Create an endpoint pointing at <gateway>/webhooks/clerk,
# subscribed to `user.deleted` and `user.updated`. Clerk mints one secret per
# endpoint, not per instance -- a second endpoint needs its own variable, not
# a reuse of this one. Starts with `whsec_`.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------------------------
# Supabase — PostgreSQL (https://supabase.com/dashboard)
# ---------------------------------------------------------------------------
# Left unset on purpose. Compose supplies the container-network default, where the
# host must be `postgres` — `localhost` inside the gateway container is the gateway
# itself. Set this only to point the gateway elsewhere, e.g. Supabase.
#
# The gateway connects as `gateway_app`, the least-privilege role RLS applies to
# The migration creates it and `agent_ro` as NOLOGIN; on Supabase, grant
# them a login and password once (see db/README.md).
#
# Against Supabase use port 5432 (session mode), not 6543: the transaction pooler
# reassigns connections between queries, which breaks the prepared statements pgx
# uses by default.
# DATABASE_URL=postgresql://gateway_app:password@db.your-project.supabase.co:5432/postgres

# Database tests skip unless this is set, and it is deliberately not DATABASE_URL
# so running the suite can never write to a configured production database. Host
# is `localhost` — the tests run on your machine, not in the compose network.
# Must be a superuser/owner connection: the RLS tests use SET ROLE to drop into
# gateway_app and agent_ro. The local compose `postgres` role is one.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/holster

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# The agent connects as agent_ro, which has no insert/update/delete grant
# anywhere — the invariant that keeps a manipulated model from modifying
# anything. It starts with no read grants either; each is added by the task that
# needs it. Consumed by the agent service once it reads the database directly.
# Host is `postgres`, not `localhost`: this is consumed inside a container, where
# `localhost` is that container itself.
DATABASE_URL_AGENT_READONLY=postgresql://agent_ro:password@postgres:5432/holster

# ---------------------------------------------------------------------------
# Internal service URLs (docker-compose networking)
# ---------------------------------------------------------------------------
# Container-network addresses: who calls whom inside compose. Not reachable
# from a browser, and not published on the host.
AGENT_SERVICE_URL=http://agent:8000
GATEWAY_SERVICE_URL=http://gateway:8080

# Ports published on the host; GATEWAY_PORT applies inside the container too.
# Moving WEB_PORT means moving CLERK_AUTHORIZED_PARTIES with it — that origin is
# what the gateway checks tokens against.
GATEWAY_PORT=8080
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Browser-facing gateway URL
# ---------------------------------------------------------------------------
# The gateway has two addresses: a browser resolves this one on the host, while
# web's server components resolve GATEWAY_SERVICE_URL inside the compose network
# (web/src/lib/gateway.ts picks between them). Compose derives this from
# GATEWAY_PORT, so set it only when the browser reaches the gateway somewhere
# other than localhost. Compiled into the bundle at build time, so a change here
# needs `docker compose up --build`.
#
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Gateway log verbosity: debug, info, warn, error. Defaults to info. Use debug to
# see why individual requests were rejected; it logs a line per rejection.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# LLM provider for the agent — Google Gemini (https://aistudio.google.com/apikey)
# Free tier; check current limits at aistudio.google.com/rate-limit before
# relying on a number here — Google's own docs no longer publish a static
# table. The agent makes two calls per chat turn (interpret + rank), so the
# free tier's per-minute cap halves your effective messages-per-minute.
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=replace_me

# Optional override for the model powering catalog_tool. Left unset on
# purpose: the agent's own default (gemini-3.5-flash-lite) lives in one
# place, agent/catalog_tool.py's DEFAULT_MODEL, not duplicated here.
# GOOGLE_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# TMDB — movie and TV catalog, plus streaming availability by region.
# App-level key, not a user credential. Read by the agent only.
# This is the v4 "API Read Access Token" from the API settings page, sent as
# `Authorization: Bearer <token>` — not the v3 api_key. Required by the agent.
# Free tier is non-commercial and requires attribution. https://www.themoviedb.org/
# ---------------------------------------------------------------------------
TMDB_API_KEY=replace_me
